# Copie para .env.local e ajuste os valores.

# Senha de acesso à área administrativa (/admin)
ADMIN_PASSWORD=dkadmin

# Segredo usado para assinar o cookie de sessão do admin.
# Gere um valor aleatório longo em produção.
ADMIN_SECRET=troque-este-segredo-em-producao

# Diretório de dados graváveis (produtos + uploads).
# Deixe em branco para usar a raiz do projeto (local).
# Em produção com volume persistente (Railway), aponte para o mountPath do volume:
# DATA_DIR=/data
